# ARGUS Platform Environment Configuration

# General Application Settings
ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
APP_NAME="ARGUS - Intelligence & Investigation Platform"

# LLM API Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# Supabase PostgreSQL Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_supabase_db_password
POSTGRES_DB=postgres
POSTGRES_HOST=db.your-project-ref.supabase.co
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
DATABASE_URL=postgresql://postgres:your_supabase_db_password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Neo4j Graph Database Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=argus_graph_password

# Authentication & Security
JWT_SECRET=argus_jwt_super_secret_key_change_in_production_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Rate Limiting & Governance
RATE_LIMIT_PER_MINUTE=120
REQUIRE_EXPLANATION_SHAP=true
AUDIT_LOG_IMMUTABLE=true
